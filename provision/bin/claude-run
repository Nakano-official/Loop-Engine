#!/usr/bin/env bash
# Start a Claude role, non-interactively, on one brief.
#
#     sudo -u <role> /srv/loop/bin/<role>-run <brief-file> [seconds]
#
# One script for every Claude role (definer, designer, tester, critic, ...),
# installed once per role by roles.py. The runner has no sudo; the only thing
# /etc/sudoers.d/91-loop-roles lets it do is start <role>-run as <role>.
# Sideways, never up.
#
# WHICH role this is comes from the uid, not from an argument. The runner
# chooses which launcher to start and sudo decides who it runs as; nothing the
# runner passes can make a definer run with a designer's tools or credentials.
set -euo pipefail

ROLE="$(id -un)"
BRIEF="${1:?usage: $ROLE-run <brief-file> [seconds]}"
# Seconds before the agent is stopped. Enforced here rather than by the runner,
# which belongs to a different uid and cannot signal this process at all.
LIMIT="${2:-900}"
case "$LIMIT" in ""|*[!0-9]*) echo "$ROLE-run: bad time limit: $LIMIT" >&2; exit 2 ;; esac

IN="/srv/loop/roles/$ROLE/in"
OUT="/srv/loop/roles/$ROLE/out"

# The tools, the model, and whether it has the run tool come from the role
# table, and only a Claude role has any.
SPEC="$(python3 - "$ROLE" <<'EOF'
import json, sys
role = json.load(open("/etc/loop/roles.json"))["roles"].get(sys.argv[1], {})
if role.get("model") != "claude" or not role.get("invoked"):
    sys.exit(1)
print(role.get("claude_model") or "default", "yes" if role.get("code") else "no", role["tools"])
EOF
)" || { echo "$ROLE-run: $ROLE is not an invoked Claude role in /etc/loop/roles.json" >&2; exit 2; }
read -r MODEL CODE TOOLS <<<"$SPEC"

# The brief has to be one the window put in this role's own in/. A path
# anywhere else would be a second input channel beside the brief.
BRIEF="$(realpath -e -- "$BRIEF" 2>/dev/null)" || { echo "$ROLE-run: cannot read brief" >&2; exit 2; }
case "$BRIEF" in
  "$IN"/*) ;;
  *) echo "$ROLE-run: the brief must be under $IN" >&2; exit 2 ;;
esac
[ -r "$BRIEF" ] || { echo "$ROLE-run: cannot read brief: $BRIEF" >&2; exit 2; }

# Its own credentials, in its own file, readable by this uid alone. The usage
# quota is per account and shared by every role whatever is in these files;
# what separate files buy is that a token can be revoked for one role alone,
# and a breach of one uid hands over that role's token only -- both only if the
# roles are given different tokens.
if [ -r "/etc/loop/$ROLE.env" ]; then
  set -a
  . "/etc/loop/$ROLE.env"
  set +a
fi
if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
  if [ -n "${ANTHROPIC_API_KEY_CONSOLE:-}" ]; then
    export ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY_CONSOLE"
    echo "$ROLE-run: no subscription token; falling back to Console credit" >&2
  else
    echo "$ROLE-run: no credentials in /etc/loop/$ROLE.env" >&2
    echo "    subscription (preferred): sudo -u $ROLE -H claude setup-token" >&2
    exit 3
  fi
fi
unset ANTHROPIC_API_KEY_CONSOLE

# A throwaway HOME for every invocation: no settings, no memory, no session to
# resume. Two runs on the same brief must not be able to agree by remembering.
# It is also the role's TMPDIR: /tmp is shared by every uid, and whatever one
# role leaves there another could read. umask 027: what this role writes is
# readable by its own group (the window reads out/ through it) and no one else.
umask 027
HOME="$(mktemp -d)"
export HOME TMPDIR="$HOME"
trap 'rm -rf "$HOME"' EXIT

# out/ is the one place this role writes. The window reads it, checks it, and
# copies what passes into the workspace -- no role writes a workspace itself.
cd "$OUT"

# --safe-mode / --setting-sources "" / --no-session-persistence
#     the brief is the only input.
# --tools
#     from the table: the ONLY built-in tools the agent has. Ones whose reach
#     the box bounds -- files, by the uid's rights (Read, Write, Edit, Glob,
#     Grep, TodoWrite) -- and never Bash or WebFetch: this uid reaches the
#     internet and reads its own credentials, so a command run as it could
#     too. That is why the Claude roles need no egress list (SYSTEM 8-3,
#     DECISIONS 45). Add either here and that line has to be revisited.
#     --allowedTools alone is not this: it only pre-approves tools, and every
#     other one -- Bash, WebFetch, WebSearch, Task, ... -- stays available,
#     read-only shell commands running without asking. So it was until
#     2026-10-13, when a definer was seen running `ls` (SYSTEM 8-3).
# --allowedTools
#     the same list, pre-approved: nothing is asked in a non-interactive run.
# --strict-mcp-config --mcp-config (roles with "code": true; the others keep
#     --safe-mode, which turns every MCP server off)
#     the run tool and no other server: code-mcp, which hands the code to
#     calc through calc-run -- no network, no workspace, nothing left running.
#     The role computes with it instead of in its head (DECISIONS 45).
# --model
#     from the table (claude_model). Left to the account's default, the roles
#     ran on an older model than anyone had chosen (2026-10-15).
# --output-format stream-json --verbose
#     the agent's progress, one event per line: how much it has thought, the
#     tools it called and what came back, errors, the account's rate limit,
#     and at the end the tokens it used. Written to trace/ in out/ (the window
#     makes it), where the window reads it while the role runs and takes it
#     back after. Without that line nobody could tell an agent thinking from
#     one that had stopped answering. Only the last answer goes to stdout, as
#     before.
TRACE="$OUT/trace/progress.jsonl"
[ -d "$OUT/trace" ] || TRACE="$HOME/progress.jsonl"

# CLAUDE_CODE_MAX_RETRIES=0: no retrying inside the agent. Retrying is the
#     flow's (the gate's rounds, a refused file given back to fix): it is on
#     the ledger and counted. A second retry hidden in here, up to ten times,
#     each regenerating a whole long answer, cost the quota and the time with
#     nothing to show for it (2026-10-15: a definer retried after half an hour).
#     What made that answer so long was the definer's job, not a setting: it
#     was split so that one role's answer fits (DECISIONS 44).
export CLAUDE_CODE_MAX_RETRIES=0
EXTRA=()
ALLOWED="$TOOLS"
if [ "$CODE" = yes ]; then
  EXTRA+=(--strict-mcp-config --mcp-config
          '{"mcpServers": {"code": {"type": "stdio", "command": "/srv/loop/bin/code-mcp", "args": []}}}')
  ALLOWED="$TOOLS mcp__code__run"
else
  EXTRA+=(--safe-mode)
fi
[ "$MODEL" = default ] || EXTRA+=(--model "$MODEL")
# --system-prompt: a role's own, in place of Claude Code's. Claude Code's is
#     written for a person at a terminal -- git, tests, asking before acting --
#     and is read again on every turn: about 12,000 tokens a turn, most of what
#     an analyst read, and nothing a role here uses (DECISIONS 47). The brief
#     says the rest.
SYSTEM="You are one role in an automated software loop, started non-interactively on one brief.
The brief is the user message: it says what to write, in which file, in what format. Do exactly
that, using only the tools you have, in the current directory. There is no person to ask and
nothing to report: what you write to the file is all that is read, and a gate checks it.
Edit and Write work on files in the current directory; Read a file before you Edit it."
set +e
timeout --kill-after=30 "$LIMIT" claude -p \
  "${EXTRA[@]}" \
  --system-prompt "$SYSTEM" \
  --setting-sources "" \
  --no-session-persistence \
  --tools "$TOOLS" \
  --allowedTools "$ALLOWED" \
  --output-format stream-json --verbose \
  < "$BRIEF" > "$TRACE"
rc=$?
set -e
python3 - "$TRACE" "$rc" <<'EOF'
import json, sys
result = None
for line in open(sys.argv[1], encoding="utf-8", errors="replace"):
    try:
        e = json.loads(line)
    except ValueError:
        continue
    if e.get("type") == "result":
        result = e
if result is not None:
    print(result.get("result") or result.get("subtype") or "")
else:
    print(f"(no answer: the agent was stopped, exit {sys.argv[2]})")
EOF
exit "$rc"
