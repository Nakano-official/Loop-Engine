#!/usr/bin/env bash
# Start the solver on one brief.
#
#     sudo -u solver /srv/loop/bin/solver-run <brief-file> [seconds]
#
# The runner has no sudo; /etc/sudoers.d/91-loop-roles lets it start this
# script as solver and nothing else. Sideways, never up.
#
# The solver is the local model and only the local model (DECISIONS, decision
# on egress: the solver reaches loopback port 8080 and nothing else). The codex
# tier this script used to fall back to needed the internet, and is gone.
set -euo pipefail

[ "$(id -un)" = solver ] || { echo "solver-run: must run as solver" >&2; exit 2; }
BRIEF="${1:?usage: solver-run <brief-file> [seconds]}"
LIMIT="${2:-900}"
case "$LIMIT" in ""|*[!0-9]*) echo "solver-run: bad time limit: $LIMIT" >&2; exit 2 ;; esac

IN=/srv/loop/roles/solver/in
OUT=/srv/loop/roles/solver/out

BRIEF="$(realpath -e -- "$BRIEF" 2>/dev/null)" || { echo "solver-run: cannot read brief" >&2; exit 2; }
case "$BRIEF" in
  "$IN"/*) ;;
  *) echo "solver-run: the brief must be under $IN" >&2; exit 2 ;;
esac

HELPER=/srv/loop/bin/solver-local
[ -x "$HELPER" ] || {
  echo "solver-run: $HELPER is missing. Run provision/70-local-solver.sh" >&2
  exit 4
}

# sudo does not reliably hand HOME to the target user.
export HOME=/home/solver

# Its own TMPDIR and umask 027, as every role: /tmp is shared by every uid,
# and what one role leaves there another could read.
umask 027
TMPDIR="$(mktemp -d -p /home/solver)"
export TMPDIR
trap 'rm -rf "$TMPDIR"' EXIT

# solver-local reads the files it may change from its working directory and
# writes whole files back into it. That directory is out/, not a workspace: the
# window stages the current contents here, and afterwards checks every path
# that came back against the allowlist before anything reaches src/.
cd "$OUT"
"$HELPER" "$BRIEF" "$LIMIT"
