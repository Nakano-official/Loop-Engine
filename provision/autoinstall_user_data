#cloud-config
# VirtualBox unattended-install template for the loop-runner VM.
# Based on VirtualBox's stock ubuntu_autoinstall_user_data, with two changes:
#   1. ssh.install-server enabled + host public key baked in (the stock
#      template installs no SSH server, which locks you out of a headless VM)
#   2. timezone fixed to Asia/Tokyo instead of the RTC conditional
# The late-commands block must be kept verbatim: VirtualBox uses
# vboxpostinstall.sh to detect that the installation finished.
autoinstall:
  version: 1

  apt:
    fallback: offline-install

  locale: @@VBOX_INSERT_LOCALE@@
  keyboard:
    layout: us

  identity:
    realname: '@@VBOX_INSERT_USER_FULL_NAME@@'
    username: '@@VBOX_INSERT_USER_LOGIN@@'
    password: '@@VBOX_INSERT_USER_PASSWORD_SHACRYPT512@@'
    hostname: '@@VBOX_INSERT_HOSTNAME_WITHOUT_DOMAIN@@'

  ssh:
    install-server: true
    # Password auth stays on through the install as a fallback in case the
    # baked-in key fails to land; provisioning turns it off (see 30-lockdown).
    allow-pw: true
    authorized-keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKxNR4PYPOUCkAP3OP5jPAk87RTnYnYAYw5QLKLLxSGU loop-runner-vm

  shutdown: reboot

  storage:
    layout:
      name: direct
    swap:
      size: 0

@@VBOX_COND_HAS_PROXY@@
  proxy: @@VBOX_INSERT_PROXY@@
@@VBOX_COND_END@@

  late-commands:
    - cp /cdrom/vboxpostinstall.sh /target/root/vboxpostinstall.sh
    - chmod +x /target/root/vboxpostinstall.sh
    - curtin in-target --target=/target -- /bin/bash /root/vboxpostinstall.sh --direct

  user-data:
    users:
      - name: root
        primary_group: root
        groups: sudo
        lock-passwd: false
        passwd: '@@VBOX_INSERT_USER_PASSWORD_SHACRYPT512@@'
        uid: 0

    timezone: Asia/Tokyo

    ntp:
        enabled: true
