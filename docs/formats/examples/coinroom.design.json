 "modules": [
  {
   "id": "M1",
   "name": "motion",
   "kind": "pure",
   "depends_on": [],
   "functions": {
    "look": {
     "params": [
      {
       "name": "player",
       "type": "Player"
      },
      {
       "name": "dx",
       "type": "float"
      },
      {
       "name": "dy",
       "type": "float"
      }
     ],
     "returns": "Player",
     "doc": "x と z はそのまま。yaw は player.yaw - dx * 0.0025。pitch は player.pitch - dy * 0.0025 を -1.5 以上 1.5 以下に収めた値（下回れば -1.5、上回れば 1.5）。新しい Player を返す。"
    },
    "walk": {
     "params": [
      {
       "name": "player",
       "type": "Player"
      },
      {
       "name": "keys",
       "type": "list<string>"
      },
      {
       "name": "dt",
       "type": "float"
      }
     ],
     "returns": "Player",
     "doc": "f = (keys に \"w\" があれば 1、なければ 0) - (keys に \"s\" があれば 1、なければ 0)。r = (\"d\" があれば 1) - (\"a\" があれば 1)。ほかのキーは無視する。s = sin(player.yaw)、c = cos(player.yaw) として、dx = (-s * f + c * r) * 4.0 * dt、dz = (-c * f - s * r) * 4.0 * dt。x は player.x + dx を、z は player.z + dz を、それぞれ -9.5 以上 9.5 以下に収めた値。yaw と pitch はそのまま。斜めに歩くときも正規化しない。新しい Player を返す。"
    }
   },
   "examples": [
    {
     "id": "M1.E1",
     "steps": [
      {
       "let": "r",
       "call": "look",
       "args": {
        "player": {
         "x": 0.0,
         "z": 0.0,
         "yaw": 0.0,
         "pitch": 0.0
        },
        "dx": 100.0,
        "dy": 0.0
       }
      }
     ],
     "then": {
      "observe": [
       "r"
      ],
      "equals": [
       {
        "x": 0.0,
        "z": 0.0,
        "yaw": -0.25,
        "pitch": 0.0
       }
      ]
     }
    },
