           "x": 6.0,
           "z": -6.0,
           "taken": false
          },
          {
           "id": "c4",
           "x": -6.0,
           "z": 4.0,
           "taken": true
          },
          {
           "id": "c5",
           "x": 6.0,
           "z": 4.0,
           "taken": false
          }
         ],
         "last": 0.0
        }
       }
      },
      {
       "let": "w",
       "call": "decode",
       "args": {
        "text": {
         "$": "t"
        }
       }
      }
     ],
     "then": {
