  {
   "id": "M5",
   "name": "save",
   "kind": "pure",
   "depends_on": [],
   "functions": {
    "encode": {
     "params": [
      {
       "name": "world",
       "type": "World"
      }
     ],
     "returns": "string",
     "doc": "world を JSON にした文字列を返す: {\"player\": {x, z, yaw, pitch}, \"coins\": [{id, x, z, taken}, ...], \"last\": last}。"
    },
    "decode": {
     "params": [
      {
       "name": "text",
       "type": "string"
      }
     ],
     "returns": "World",
     "raises": [
      "CorruptSave"
     ],
     "doc": "text を JSON として読む。読めない、または player が x/z/yaw/pitch を数で持つオブジェクトでない、coins が配列でない、そのどれかの要素が id 文字列・x/z 数・taken 真偽値を持たない、last が数でない、のどれかなら CorruptSave を投げる。そうでなければ読んだ値から新しい World を作って返す（余分なキーは捨てる）。"
    }
   },
   "examples": [
    {
     "id": "M5.E1",
     "steps": [
      {
       "let": "t",
       "call": "encode",
       "args": {
        "world": {
         "player": {
          "x": -2.0,
          "z": 3.0,
          "yaw": 0.5,
          "pitch": -0.25
         },
         "coins": [
          {
           "id": "c1",
           "x": 0.0,
