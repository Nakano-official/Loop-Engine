  {
   "id": "M6",
   "name": "game",
   "kind": "assembly",
   "depends_on": [
    "M1",
    "M2",
    "M3",
    "M4",
    "M5"
   ],
   "functions": {
    "start": {
     "params": [
      {
       "name": "now",
       "type": "float"
      },
      {
       "name": "saved",
       "type": "optional<string>"
      }
     ],
     "returns": "World",
     "raises": [
      "CorruptSave"
     ],
     "doc": "saved が null なら layout.new_world(now) を返す。そうでなければ w = save.decode(saved)（CorruptSave はそのまま投げる）として、w の last だけを now に替えた World を返す。"
    },
    "step": {
     "params": [
      {
       "name": "state",
       "type": "World"
      },
      {
       "name": "now",
       "type": "float"
      },
      {
       "name": "input",
       "type": "Input"
      }
     ],
     "returns": "World",
     "doc": "dt = now - state.last を 0.0 以上 0.25 以下に収める。p = state.player。input.locked なら p = motion.look(p, input.mouse_dx, input.mouse_dy)。p = motion.walk(p, input.keys, dt)。coins = pickup.collect(state.coins, p.x, p.z)。{player: p, coins, last: now} を返す。"
    },
    "act": {
     "params": [
      {
       "name": "state",
       "type": "World"
      },
      {
       "name": "action",
       "type": "string"
      },
      {
       "name": "now",
       "type": "float"
      }
     ],
     "returns": "World",
     "doc": "action が \"restart\" なら layout.new_world(now) を返す。それ以外（\"click\" を含む）なら state をそのまま返す。"
    },
    "screen": {
     "params": [
      {
       "name": "state",
       "type": "World"
      }
     ],
     "returns": "Scene",
     "doc": "scene.build(state) を返す。"
    },
    "save": {
     "params": [
      {
       "name": "state",
       "type": "World"
      }
     ],
     "returns": "string",
     "doc": "save.encode(state) を返す。"
    }
   },
   "examples": []
  }
 ],
 "shell": {
  "calls": "M6",
  "note": "定義の shell.duties を満たす。localStorage と時計と入力と WebGL はここにしか無い。中身は人間のレビューで確かめる"
 }
