{
  "format": "loop/design@1",
  "definition": "idlegame.definition.json",
  "target": {"language": "typescript", "platform": "browser-dom"},
  "types": {
    "NodeKind": {"enum": ["heading", "text", "button"]},
    "Node": {
      "record": [
        {"name": "kind", "type": "NodeKind"},
        {"name": "text", "type": "string"},
        {"name": "action", "type": "string"},
        {"name": "enabled", "type": "bool"}
      ]
    },
    "Screen": {
      "record": [
        {"name": "title", "type": "string"},
        {"name": "nodes", "type": "list<Node>"}
      ]
    },
    "GameState": {
      "record": [
        {"name": "resource", "type": "float"},
        {"name": "owned", "type": "map<string,int>"},
        {"name": "last_update", "type": "float"}
      ]
    },
    "Row": {
      "record": [
        {"name": "name", "type": "string"},
        {"name": "label", "type": "string"},
        {"name": "button_label", "type": "string"},
        {"name": "affordable", "type": "bool"}
      ]
    },
    "View": {
      "record": [
        {"name": "resource_text", "type": "string"},
        {"name": "rate_text", "type": "string"},
        {"name": "rows", "type": "list<Row>"}
      ]
    },
    "GeneratorSpec": {
      "record": [
        {"name": "name", "type": "string"},
        {"name": "base_cost", "type": "float"},
        {"name": "base_rate", "type": "float"},
        {"name": "cost_scale", "type": "float"}
      ]
    },
    "Scaled": {
      "record": [
        {"name": "value", "type": "float"},
        {"name": "unit", "type": "string"}
      ]
    }
  },
  "errors": {
    "NotEnough": "資源が値段に足りない",
    "UnknownGenerator": "その名前の生産設備は無い",
    "TimeWentBackwards": "与えられた時刻が、最後に更新した時刻より前",
    "CorruptSave": "保存データとして読めない",
    "NegativeAmount": "表示する量が負"
  },
  "fixtures": {
    "CATALOG": {
      "type": "list<GeneratorSpec>",
      "value": [
        {"name": "cursor", "base_cost": 15.0, "base_rate": 0.25, "cost_scale": 1.5},
        {"name": "grandma", "base_cost": 100.0, "base_rate": 2.0, "cost_scale": 1.5}
      ]
    },
    "CURSOR": {
      "type": "GeneratorSpec",
      "value": {"name": "cursor", "base_cost": 15.0, "base_rate": 0.25, "cost_scale": 1.5}
    }
  },
  "modules": [
    {
      "id": "M1",
      "name": "catalog",
      "kind": "pure",
      "depends_on": [],
      "functions": {
        "default_catalog": {"params": [], "returns": "list<GeneratorSpec>", "doc": "cursor（base_cost 15.0・base_rate 0.25・cost_scale 1.5）と grandma（base_cost 100.0・base_rate 2.0・cost_scale 1.5）を、この順の list で返す。呼ぶたびに新しい list を作る。"},
        "find_spec": {
          "params": [{"name": "catalog", "type": "list<GeneratorSpec>"}, {"name": "name", "type": "string"}],
          "returns": "GeneratorSpec",
          "raises": ["UnknownGenerator"],
          "doc": "catalog の中から name が一致する最初の GeneratorSpec を返す。無ければ UnknownGenerator を投げる。"
        }
      },
      "examples": [
        {
          "id": "M1.E1",
          "steps": [{"let": "c", "call": "default_catalog", "args": {}}],
          "then": {"observe": ["c"], "equals": [{"$": "CATALOG"}]}
        },
        {
          "id": "M1.E2",
          "steps": [{"let": "g", "call": "find_spec", "args": {"catalog": {"$": "CATALOG"}, "name": "grandma"}}],
          "then": {"observe": ["g"], "equals": [{"name": "grandma", "base_cost": 100.0, "base_rate": 2.0, "cost_scale": 1.5}]}
        },
        {
          "id": "M1.E3",
          "steps": [{"let": "g", "call": "find_spec", "args": {"catalog": {"$": "CATALOG"}, "name": "dragon"}}],
          "then": {"raises": "UnknownGenerator"}
        }
      ]
    },
    {
      "id": "M2",
      "name": "economy",
      "kind": "pure",
      "depends_on": [],
      "functions": {
        "current_cost": {
          "params": [{"name": "spec", "type": "GeneratorSpec"}, {"name": "owned", "type": "int"}],
          "returns": "float",
          "doc": "spec.base_cost に spec.cost_scale の owned 乗を掛けた値を返す。"
        },
        "production_rate": {
          "params": [{"name": "owned", "type": "map<string,int>"}, {"name": "catalog", "type": "list<GeneratorSpec>"}],
          "returns": "float",
          "raises": ["UnknownGenerator"],
          "doc": "owned の各項目（名前と所有数）について、catalog から同じ名前の spec を探し、所有数 × base_rate を足し合わせて返す。owned が空なら 0.0。catalog に無い名前があれば UnknownGenerator を投げる。"
        }
      },
      "examples": [
        {
          "id": "M2.E1",
          "from": "D3",
          "steps": [{"let": "p", "call": "current_cost", "args": {"spec": {"$": "CURSOR"}, "owned": 2}}],
          "then": {"observe": ["p"], "equals": [33.75]}
        },
        {
          "id": "M2.E2",
          "steps": [{"let": "p", "call": "current_cost", "args": {"spec": {"$": "CURSOR"}, "owned": 0}}],
          "then": {"observe": ["p"], "equals": [15.0]}
        },
        {
          "id": "M2.E3",
          "from": "D4",
          "steps": [{"let": "r", "call": "production_rate", "args": {"owned": {"cursor": 3, "grandma": 2}, "catalog": {"$": "CATALOG"}}}],
          "then": {"observe": ["r"], "equals": [4.75]}
        },
        {
          "id": "M2.E4",
          "steps": [{"let": "r", "call": "production_rate", "args": {"owned": {}, "catalog": {"$": "CATALOG"}}}],
          "then": {"observe": ["r"], "equals": [0.0]}
        },
        {
          "id": "M2.E5",
          "steps": [{"let": "r", "call": "production_rate", "args": {"owned": {"dragon": 1}, "catalog": {"$": "CATALOG"}}}],
          "then": {"raises": "UnknownGenerator"}
        }
      ]
    },
    {
      "id": "M8",
      "name": "scale",
      "kind": "pure",
      "depends_on": [],
      "functions": {
        "scale_down": {
          "params": [{"name": "value", "type": "float"}],
          "returns": "Scaled",
          "raises": ["NegativeAmount"],
          "doc": "value が負なら NegativeAmount を投げる。unit を空文字から始め、value が 1000 以上で、かつ unit が \"T\" でない間、value を 1000 で割り、unit を \"\" → \"K\" → \"M\" → \"B\" → \"T\" と1つずつ進める。最後の value と unit を返す。"
        }
      },
      "examples": [
        {
          "id": "M8.E1",
          "steps": [{"let": "r", "call": "scale_down", "args": {"value": 2500.0}}],
          "then": {"observe": ["r"], "equals": [{"value": 2.5, "unit": "K"}]}
        },
        {
          "id": "M8.E2",
          "steps": [{"let": "r", "call": "scale_down", "args": {"value": 0.0}}],
          "then": {"observe": ["r"], "equals": [{"value": 0.0, "unit": ""}]}
        },
        {
          "id": "M8.E3",
          "steps": [{"let": "r", "call": "scale_down", "args": {"value": 999.99}}],
          "then": {"observe": ["r"], "equals": [{"value": 999.99, "unit": ""}]}
        },
        {
          "id": "M8.E4",
          "steps": [{"let": "r", "call": "scale_down", "args": {"value": 1000.0}}],
          "then": {"observe": ["r"], "equals": [{"value": 1.0, "unit": "K"}]}
        },
        {
          "id": "M8.E5",
          "steps": [{"let": "r", "call": "scale_down", "args": {"value": 1500000.0}}],
          "then": {"observe": ["r"], "equals": [{"value": 1.5, "unit": "M"}]}
        },
        {
          "id": "M8.E6",
          "steps": [{"let": "r", "call": "scale_down", "args": {"value": 2000000000.0}}],
          "then": {"observe": ["r"], "equals": [{"value": 2.0, "unit": "B"}]}
        },
        {
          "id": "M8.E7",
          "steps": [{"let": "r", "call": "scale_down", "args": {"value": 5000000000000000.0}}],
          "then": {"observe": ["r"], "equals": [{"value": 5000.0, "unit": "T"}]}
        },
        {
          "id": "M8.E8",
          "steps": [{"let": "r", "call": "scale_down", "args": {"value": -1.0}}],
          "then": {"raises": "NegativeAmount"}
        }
      ]
    },
    {
      "id": "M3",
      "name": "format",
      "kind": "pure",
      "depends_on": ["M8"],
      "functions": {
        "format_amount": {
          "params": [{"name": "value", "type": "float"}],
          "returns": "string",
          "raises": ["NegativeAmount"],
          "doc": "scale.scale_down(value) で、値と単位を得る（value が負なら、scale_down が投げる NegativeAmount をそのまま通す）。得た値を小数2桁の文字列にし、後ろに単位を付けて返す。例: scale_down(2500) は {value: 2.5, unit: \"K\"} なので \"2.50K\"。"
        },
        "format_rate": {
          "params": [{"name": "value", "type": "float"}],
          "returns": "string",
          "raises": ["NegativeAmount"],
          "doc": "format_amount(value) の後ろに \"/s\" を付けて返す。value が負なら NegativeAmount を投げる。"
        }
      },
      "examples": [
        {
          "id": "M3.E1",
          "from": "D5",
          "steps": [{"let": "s", "call": "format_amount", "args": {"value": 2500.0}}],
          "then": {"observe": ["s"], "equals": ["2.50K"]}
        },
        {
          "id": "M3.E2",
          "steps": [{"let": "s", "call": "format_amount", "args": {"value": 0.0}}],
          "then": {"observe": ["s"], "equals": ["0.00"]}
        },
        {
          "id": "M3.E3",
          "steps": [{"let": "s", "call": "format_amount", "args": {"value": 999.99}}],
          "then": {"observe": ["s"], "equals": ["999.99"]}
        },
        {
          "id": "M3.E4",
          "steps": [{"let": "s", "call": "format_amount", "args": {"value": 1000.0}}],
          "then": {"observe": ["s"], "equals": ["1.00K"]}
        },
        {
          "id": "M3.E5",
          "steps": [{"let": "s", "call": "format_amount", "args": {"value": 1500000.0}}],
          "then": {"observe": ["s"], "equals": ["1.50M"]}
        },
        {
          "id": "M3.E6",
          "steps": [{"let": "s", "call": "format_amount", "args": {"value": -1.0}}],
          "then": {"raises": "NegativeAmount"}
        },
        {
          "id": "M3.E7",
          "steps": [{"let": "s", "call": "format_rate", "args": {"value": 0.5}}],
          "then": {"observe": ["s"], "equals": ["0.50/s"]}
        },
        {
          "id": "M3.E8",
          "steps": [{"let": "s", "call": "format_rate", "args": {"value": 2500.0}}],
          "then": {"observe": ["s"], "equals": ["2.50K/s"]}
        }
      ]
    },
    {
      "id": "M4",
      "name": "rules",
      "kind": "pure",
      "depends_on": ["M1", "M2"],
      "functions": {
        "click": {
          "params": [{"name": "state", "type": "GameState"}],
          "returns": "GameState",
          "doc": "state の resource に 1.0 を足した新しい GameState を返す。owned と last_update はそのまま。"
        },
        "buy": {
          "params": [{"name": "state", "type": "GameState"}, {"name": "catalog", "type": "list<GeneratorSpec>"}, {"name": "name", "type": "string"}],
          "returns": "GameState",
          "raises": ["NotEnough", "UnknownGenerator"],
          "doc": "catalog.find_spec(catalog, name) で spec を得る（無ければ UnknownGenerator）。その設備の今の所有数（owned に無ければ 0）で economy.current_cost(spec, 所有数) を値段とする。state.resource が値段未満なら NotEnough を投げる。そうでなければ、resource から値段を引き、その設備の所有数を 1 増やした新しい GameState を返す。last_update はそのまま。受け取った state は変えない。"
        },
        "tick": {
          "params": [{"name": "state", "type": "GameState"}, {"name": "catalog", "type": "list<GeneratorSpec>"}, {"name": "now", "type": "float"}],
          "returns": "GameState",
          "raises": ["TimeWentBackwards"],
          "doc": "now - state.last_update を経過秒数とする。負なら TimeWentBackwards を投げる。economy.production_rate(state.owned, catalog) × 経過秒数を resource に足し、last_update を now にした新しい GameState を返す。"
        }
      },
      "examples": [
        {
          "id": "M4.E1",
          "from": "D2",
          "steps": [{"let": "c", "call": "click", "args": {"state": {"resource": 0.0, "owned": {}, "last_update": 5.0}}}],
          "then": {"observe": ["c"], "equals": [{"resource": 1.0, "owned": {}, "last_update": 5.0}]}
        },
        {
          "id": "M4.E2",
          "from": "D3",
          "steps": [{"let": "b", "call": "buy", "args": {
            "state": {"resource": 15.0, "owned": {}, "last_update": 0.0}, "catalog": {"$": "CATALOG"}, "name": "cursor"}}],
          "then": {"observe": ["b"], "equals": [{"resource": 0.0, "owned": {"cursor": 1}, "last_update": 0.0}]}
        },
        {
          "id": "M4.E3",
          "steps": [{"let": "b", "call": "buy", "args": {
            "state": {"resource": 22.5, "owned": {"cursor": 1}, "last_update": 0.0}, "catalog": {"$": "CATALOG"}, "name": "cursor"}}],
          "then": {"observe": ["b"], "equals": [{"resource": 0.0, "owned": {"cursor": 2}, "last_update": 0.0}]}
        },
        {
          "id": "M4.E4",
          "steps": [{"let": "b", "call": "buy", "args": {
            "state": {"resource": 10.0, "owned": {}, "last_update": 0.0}, "catalog": {"$": "CATALOG"}, "name": "cursor"}}],
          "then": {"raises": "NotEnough"}
        },
        {
          "id": "M4.E5",
          "steps": [
            {"let": "s", "value": {"resource": 15.0, "owned": {}, "last_update": 0.0}, "type": "GameState"},
            {"let": "b", "call": "buy", "args": {"state": {"$": "s"}, "catalog": {"$": "CATALOG"}, "name": "cursor"}}
          ],
          "then": {"observe": ["s"], "equals": [{"resource": 15.0, "owned": {}, "last_update": 0.0}]}
        },
        {
          "id": "M4.E6",
          "from": "D4",
          "steps": [{"let": "t", "call": "tick", "args": {
            "state": {"resource": 0.0, "owned": {"cursor": 3, "grandma": 2}, "last_update": 0.0}, "catalog": {"$": "CATALOG"}, "now": 10.0}}],
          "then": {"observe": ["t"], "equals": [{"resource": 47.5, "owned": {"cursor": 3, "grandma": 2}, "last_update": 10.0}]}
        },
        {
          "id": "M4.E7",
          "steps": [{"let": "t", "call": "tick", "args": {
            "state": {"resource": 5.0, "owned": {"cursor": 1}, "last_update": 10.0}, "catalog": {"$": "CATALOG"}, "now": 10.0}}],
          "then": {"observe": ["t"], "equals": [{"resource": 5.0, "owned": {"cursor": 1}, "last_update": 10.0}]}
        },
        {
          "id": "M4.E8",
          "steps": [{"let": "t", "call": "tick", "args": {
            "state": {"resource": 0.0, "owned": {}, "last_update": 10.0}, "catalog": {"$": "CATALOG"}, "now": 9.0}}],
          "then": {"raises": "TimeWentBackwards"}
        }
      ]
    },
    {
      "id": "M5",
      "name": "save",
      "kind": "pure",
      "depends_on": [],
      "functions": {
        "encode": {
          "params": [{"name": "state", "type": "GameState"}],
          "returns": "string",
          "doc": "state を JSON 文字列にする。キーは resource・owned・last_update の3つ。"
        },
        "decode": {
          "params": [{"name": "text", "type": "string"}],
          "returns": "GameState",
          "raises": ["CorruptSave"],
          "doc": "text を JSON として読み、resource（数）・owned（文字列から整数への対応）・last_update（数）を持つ GameState を返す。JSON として読めない、キーが欠けている、型が違うときは CorruptSave を投げる。"
        }
      },
      "examples": [
        {
          "id": "M5.E1",
          "from": "D6",
          "steps": [
            {"let": "t", "call": "encode", "args": {"state": {"resource": 12.5, "owned": {"cursor": 1}, "last_update": 100.0}}},
            {"let": "r", "call": "decode", "args": {"text": {"$": "t"}}}
          ],
          "then": {"observe": ["r"], "equals": [{"resource": 12.5, "owned": {"cursor": 1}, "last_update": 100.0}]}
        },
        {
          "id": "M5.E2",
          "steps": [{"let": "r", "call": "decode", "args": {"text": "{\"resource\":1.5,\"owned\":{\"cursor\":2},\"last_update\":3.0}"}}],
          "then": {"observe": ["r"], "equals": [{"resource": 1.5, "owned": {"cursor": 2}, "last_update": 3.0}]}
        },
        {
          "id": "M5.E3",
          "steps": [{"let": "r", "call": "decode", "args": {"text": "not a save"}}],
          "then": {"raises": "CorruptSave"}
        },
        {
          "id": "M5.E4",
          "steps": [{"let": "r", "call": "decode", "args": {"text": "{\"resource\":1.5}"}}],
          "then": {"raises": "CorruptSave"}
        }
      ]
    },
    {
      "id": "M6",
      "name": "view",
      "kind": "pure",
      "depends_on": ["M2", "M3"],
      "functions": {
        "render": {
          "params": [{"name": "state", "type": "GameState"}, {"name": "catalog", "type": "list<GeneratorSpec>"}],
          "returns": "View",
          "doc": "resource_text は format.format_amount(state.resource)。rate_text は format.format_rate(economy.production_rate(state.owned, catalog))。rows は catalog の順に1設備1行で、所有数を n（owned に無ければ 0）、値段を cost = economy.current_cost(spec, n) として、name は spec.name、label は \"<name> x<n>\"、button_label は \"Buy <name> (<format.format_amount(cost)>)\"、affordable は state.resource >= cost。"
        }
      },
      "examples": [
        {
          "id": "M6.E1",
          "from": "D5",
          "steps": [{"let": "v", "call": "render", "args": {
            "state": {"resource": 2500.0, "owned": {"cursor": 2}, "last_update": 0.0}, "catalog": {"$": "CATALOG"}}}],
          "then": {"observe": ["v"], "equals": [{
            "resource_text": "2.50K",
            "rate_text": "0.50/s",
            "rows": [
              {"name": "cursor", "label": "cursor x2", "button_label": "Buy cursor (33.75)", "affordable": true},
              {"name": "grandma", "label": "grandma x0", "button_label": "Buy grandma (100.00)", "affordable": true}
            ]
          }]}
        },
        {
          "id": "M6.E2",
          "steps": [{"let": "v", "call": "render", "args": {
            "state": {"resource": 0.0, "owned": {}, "last_update": 0.0}, "catalog": [{"name": "cursor", "base_cost": 15.0, "base_rate": 0.25, "cost_scale": 1.5}]}}],
          "then": {"observe": ["v"], "equals": [{
            "resource_text": "0.00",
            "rate_text": "0.00/s",
            "rows": [
              {"name": "cursor", "label": "cursor x0", "button_label": "Buy cursor (15.00)", "affordable": false}
            ]
          }]}
        }
      ]
    },
    {
      "id": "M7",
      "name": "game",
      "kind": "assembly",
      "depends_on": ["M1", "M4", "M5", "M6"],
      "functions": {
        "new_game": {
          "params": [{"name": "now", "type": "float"}],
          "returns": "GameState",
          "doc": "resource 0.0、owned 空、last_update は now の GameState を返す。"
        },
        "click": {
          "params": [{"name": "state", "type": "GameState"}],
          "returns": "GameState",
          "doc": "rules.click(state) を返す。"
        },
        "buy": {
          "params": [{"name": "state", "type": "GameState"}, {"name": "name", "type": "string"}],
          "returns": "GameState",
          "raises": ["NotEnough", "UnknownGenerator"],
          "doc": "rules.buy(state, catalog.default_catalog(), name) を返す。"
        },
        "tick": {
          "params": [{"name": "state", "type": "GameState"}, {"name": "now", "type": "float"}],
          "returns": "GameState",
          "raises": ["TimeWentBackwards"],
          "doc": "rules.tick(state, catalog.default_catalog(), now) を返す。"
        },
        "view": {
          "params": [{"name": "state", "type": "GameState"}],
          "returns": "View",
          "doc": "view.render(state, catalog.default_catalog()) を返す。"
        },
        "save": {
          "params": [{"name": "state", "type": "GameState"}],
          "returns": "string",
          "doc": "save.encode(state) を返す。"
        },
        "load": {
          "params": [{"name": "saved", "type": "optional<string>"}, {"name": "now", "type": "float"}],
          "returns": "GameState",
          "raises": ["CorruptSave", "TimeWentBackwards"],
          "doc": "saved が null なら new_game(now) を返す。そうでなければ save.decode(saved) で状態を読み、rules.tick(読んだ状態, catalog.default_catalog(), now) で now まで進めて返す。これで離れていたあいだの生産が加わり、時刻が戻っていれば TimeWentBackwards になる。"
        },
        "start": {
          "params": [{"name": "now", "type": "float"}, {"name": "saved", "type": "optional<string>"}],
          "returns": "GameState",
          "raises": ["CorruptSave", "TimeWentBackwards"],
          "doc": "load(saved, now) を返す。"
        },
        "step": {
          "params": [{"name": "state", "type": "GameState"}, {"name": "now", "type": "float"}],
          "returns": "GameState",
          "raises": ["TimeWentBackwards"],
          "doc": "tick(state, now) を返す。"
        },
        "act": {
          "params": [{"name": "state", "type": "GameState"}, {"name": "action", "type": "string"}, {"name": "now", "type": "float"}],
          "returns": "GameState",
          "raises": ["NotEnough", "UnknownGenerator"],
