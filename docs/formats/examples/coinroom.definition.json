{
 "format": "loop/definition@1",
 "title": "コイン集め",
 "types": {
  "Vec3": {
   "record": [
    {
     "name": "x",
     "type": "float"
    },
    {
     "name": "y",
     "type": "float"
    },
    {
     "name": "z",
     "type": "float"
    }
   ]
  },
  "Camera": {
   "record": [
    {
     "name": "position",
     "type": "Vec3"
    },
    {
     "name": "yaw",
     "type": "float"
    },
    {
     "name": "pitch",
     "type": "float"
    },
    {
     "name": "fov",
     "type": "float"
    }
   ]
  },
  "Shape": {
   "enum": [
    "box",
    "sphere",
    "plane",
    "cylinder"
   ]
  },
  "Object3D": {
   "record": [
    {
     "name": "id",
     "type": "string"
    },
    {
     "name": "shape",
     "type": "Shape"
    },
    {
     "name": "position",
     "type": "Vec3"
    },
    {
     "name": "size",
     "type": "Vec3"
    },
    {
     "name": "rotation_y",
     "type": "float"
    },
    {
     "name": "color",
     "type": "string"
    }
   ]
  },
  "NodeKind": {
   "enum": [
    "heading",
    "text",
    "button"
   ]
  },
  "Node": {
   "record": [
    {
     "name": "kind",
     "type": "NodeKind"
    },
    {
     "name": "text",
     "type": "string"
    },
    {
     "name": "action",
     "type": "string"
    },
    {
     "name": "enabled",
     "type": "bool"
    }
   ]
  },
  "Scene": {
   "record": [
    {
     "name": "title",
     "type": "string"
    },
    {
     "name": "camera",
     "type": "Camera"
    },
    {
     "name": "objects",
     "type": "list<Object3D>"
    },
    {
     "name": "hud",
     "type": "list<Node>"
    }
   ]
  },
  "Input": {
   "record": [
    {
     "name": "keys",
     "type": "list<string>"
    },
    {
     "name": "mouse_dx",
     "type": "float"
    },
    {
     "name": "mouse_dy",
     "type": "float"
    },
    {
     "name": "locked",
     "type": "bool"
    }
   ]
  },
  "Player": {
   "record": [
    {
     "name": "x",
     "type": "float"
    },
    {
     "name": "z",
     "type": "float"
    },
    {
     "name": "yaw",
     "type": "float"
    },
    {
     "name": "pitch",
     "type": "float"
    }
   ]
  },
  "Coin": {
   "record": [
    {
     "name": "id",
     "type": "string"
    },
    {
     "name": "x",
     "type": "float"
    },
    {
     "name": "z",
     "type": "float"
    },
    {
     "name": "taken",
     "type": "bool"
    }
   ]
  },
  "World": {
   "record": [
    {
     "name": "player",
     "type": "Player"
    },
    {
     "name": "coins",
     "type": "list<Coin>"
    },
    {
     "name": "last",
     "type": "float"
    }
   ]
  }
 },
 "errors": {
  "CorruptSave": "保存データとして読めない"
 },
 "interface": {
  "start": {
   "params": [
    {
     "name": "now",
     "type": "float"
    },
    {
     "name": "saved",
     "type": "optional<string>"
    }
   ],
   "returns": "World",
   "raises": [
    "CorruptSave"
   ]
  },
  "step": {
   "params": [
    {
     "name": "state",
     "type": "World"
    },
    {
     "name": "now",
     "type": "float"
    },
    {
     "name": "input",
     "type": "Input"
    }
   ],
   "returns": "World"
  },
  "act": {
   "params": [
    {
     "name": "state",
     "type": "World"
    },
    {
     "name": "action",
     "type": "string"
    },
    {
     "name": "now",
     "type": "float"
    }
   ],
   "returns": "World"
  },
  "screen": {
   "params": [
    {
     "name": "state",
     "type": "World"
    }
   ],
   "returns": "Scene"
  },
  "save": {
   "params": [
    {
     "name": "state",
     "type": "World"
    }
   ],
   "returns": "string"
  }
 },
 "items": [
  {
   "id": "D1",
   "title": "はじまり",
   "statement": "新しいゲームは、部屋の南寄り (x 0, z 8) に北 (-z) を向いて立ち、5枚のコインが決まった位置にあり、どれもまだ拾われていない。開いた時刻を最後の時刻として持つ。",
   "examples": [
    {
     "id": "D1.E1",
     "steps": [
      {
       "let": "s",
       "call": "start",
       "args": {
        "now": 10.0,
        "saved": null
       }
      }
     ],
     "then": {
      "observe": [
       "s"
      ],
      "equals": [
       {
        "player": {
         "x": 0.0,
         "z": 8.0,
         "yaw": 0.0,
         "pitch": 0.0
        },
        "coins": [
         {
          "id": "c1",
          "x": 0.0,
          "z": 0.0,
          "taken": false
         },
         {
          "id": "c2",
          "x": -6.0,
          "z": -6.0,
          "taken": false
         },
         {
          "id": "c3",
          "x": 6.0,
          "z": -6.0,
          "taken": false
         },
         {
          "id": "c4",
          "x": -6.0,
          "z": 4.0,
          "taken": false
         },
         {
          "id": "c5",
          "x": 6.0,
          "z": 4.0,
          "taken": false
         }
        ],
        "last": 10.0
       }
      ]
     }
    }
   ]
  },
  {
   "id": "D2",
   "title": "保存と再開",
   "statement": "save した文字列を start に渡すと、同じ位置・向き・コインの状態から再開する。最後の時刻は再開した時刻になる。読めない保存は CorruptSave。",
   "examples": [
    {
     "id": "D2.E1",
     "steps": [
      {
       "let": "w",
       "value": {
        "player": {
         "x": 0.0,
         "z": 1.5,
         "yaw": 0.0,
         "pitch": 0.0
        },
        "coins": [
         {
          "id": "c1",
          "x": 0.0,
          "z": 0.0,
          "taken": false
         },
         {
          "id": "c2",
          "x": -6.0,
          "z": -6.0,
          "taken": false
         },
         {
          "id": "c3",
          "x": 6.0,
          "z": -6.0,
          "taken": false
         },
         {
          "id": "c4",
          "x": -6.0,
          "z": 4.0,
          "taken": false
         },
         {
          "id": "c5",
          "x": 6.0,
          "z": 4.0,
          "taken": false
         }
        ],
        "last": 0.0
       },
       "type": "World"
      },
      {
       "let": "t",
       "call": "save",
       "args": {
        "state": {
         "$": "w"
        }
       }
      },
      {
       "let": "u",
       "call": "start",
       "args": {
        "now": 20.0,
        "saved": {
         "$": "t"
        }
       }
      }
     ],
     "then": {
      "observe": [
       "u"
      ],
      "equals": [
       {
        "player": {
         "x": 0.0,
         "z": 1.5,
         "yaw": 0.0,
         "pitch": 0.0
        },
        "coins": [
         {
          "id": "c1",
          "x": 0.0,
          "z": 0.0,
          "taken": false
         },
         {
          "id": "c2",
          "x": -6.0,
          "z": -6.0,
          "taken": false
         },
         {
          "id": "c3",
          "x": 6.0,
          "z": -6.0,
          "taken": false
         },
         {
          "id": "c4",
          "x": -6.0,
          "z": 4.0,
          "taken": false
         },
         {
          "id": "c5",
          "x": 6.0,
          "z": 4.0,
          "taken": false
         }
        ],
        "last": 20.0
       }
      ]
     }
    },
    {
     "id": "D2.E2",
     "steps": [
      {
       "let": "s",
       "call": "start",
       "args": {
        "now": 5.0,
        "saved": "not a save"
       }
      }
     ],
     "then": {
      "raises": "CorruptSave"
     }
    }
   ]
  },
  {
   "id": "D3",
   "title": "歩く",
   "statement": "W/S で向いている方へ前後に、A/D で左右に、毎秒 4 m 歩く。歩く距離は前の step からの経過時間に比例し、経過時間は 0.25 秒を上限とする（タブが止まっていた後に飛ばない）。部屋の外 (|x|, |z| > 9.5) には出られない。",
   "examples": [
    {
     "id": "D3.E1",
     "steps": [
      {
       "let": "s",
       "call": "start",
       "args": {
        "now": 0.0,
        "saved": null
       }
      },
      {
       "let": "a",
       "call": "step",
